+	/*
+	 * Mute the text console here, not on the first present. A boot that never
+	 * presents (backboardd stuck early) would otherwise keep drawing kernel
+	 * and userland console output over the panel forever, which is exactly
+	 * the "endless scrolling" case. Panics still draw.
+	 */
+	{
+		int quiet = 0;
+		if (PE_parse_boot_argn("sweetfb_noconsole", &quiet, sizeof(quiet)) && quiet != 0) {
+			sweet_console_muted = 1;
+		}
+	}
