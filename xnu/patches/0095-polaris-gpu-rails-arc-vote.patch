+/*
+ * Rails backend. Everything here is bounded and reversible:
+ *
+ *  - ARC votes are low and RPMh takes the maximum across owners, so they can
+ *    never pull a corner below what somebody else already holds.
+ *  - Only the CX domain is switched on, and only if it was off; the previous
+ *    register value is kept so unwind() can put it back.
+ *  - GX is left alone on purpose. The contract is explicit that GX goes
+ *    through the GMU, so this stage stops at the wrapper.
+ *
+ * The chip id read is a free observation, not a success condition: with GX
+ * still collapsed the core cannot answer, and a zero read tells us exactly
+ * that rather than proving anything wrong.
+ */
+static bool
+polaris_gpu_rails_backend(struct polaris_gpu_context *ctx)
+{
+	static const char *const corners[] = { "cx.lvl", "mx.lvl", "gfx.lvl" };
+
+	if (!polaris_gpu_regs) {
+		polaris_gpu_regs = ml_io_map(POLARIS_GPU_REGS_PA, POLARIS_GPU_REGS_SIZE);
+		if (!polaris_gpu_regs) {
+			printf("POLARIS GPU: rails: GPUCC mapping failed\n");
+			return false;
+		}
+	}
+
+	uint32_t cx = polaris_gpu_rd(POLARIS_GPU_CX_GDSCR);
+	uint32_t gx = polaris_gpu_rd(POLARIS_GPU_GX_GDSCR);
+	printf("POLARIS GPU: rails: cx-gdscr=%#x gx-gdscr=%#x chip-id=%#x\n",
+	    cx, gx, polaris_gpu_rd(POLARIS_GPU_CHIPID));
+
+	for (unsigned i = 0; i < sizeof(corners) / sizeof(corners[0]); ++i) {
+		int error = sweet_rpmh_arc_level(corners[i], POLARIS_GPU_ARC_LEVEL);
+		printf("POLARIS GPU: rails: %s=%u -> %d\n", corners[i],
+		    POLARIS_GPU_ARC_LEVEL, error);
+		if (error) {
+			/* A refused vote means the RSC is unusable for us this boot. */
+			return false;
+		}
+	}
+
+	if (cx & POLARIS_GPU_GDSC_PWR_ON) {
+		printf("POLARIS GPU: rails: CX already powered, not claimed\n");
+	} else {
+		ctx->cx_gdscr_saved = cx;
+		ctx->owned |= POLARIS_GPU_OWN_CX;
+		polaris_gpu_wr(POLARIS_GPU_CX_GDSCR, cx & ~POLARIS_GPU_GDSC_COLLAPSE);
+		for (unsigned i = 0; i < 100; ++i) {
+			cx = polaris_gpu_rd(POLARIS_GPU_CX_GDSCR);
+			if (cx & POLARIS_GPU_GDSC_PWR_ON) {
+				break;
+			}
+			delay(1);
+		}
+		printf("POLARIS GPU: rails: CX power-on -> %#x (%s)\n", cx,
+		    (cx & POLARIS_GPU_GDSC_PWR_ON) ? "up" : "still collapsed");
+		if (!(cx & POLARIS_GPU_GDSC_PWR_ON)) {
+			polaris_gpu_wr(POLARIS_GPU_CX_GDSCR, ctx->cx_gdscr_saved);
+			ctx->owned &= ~POLARIS_GPU_OWN_CX;
+			return false;
+		}
+	}
+
+	printf("POLARIS GPU: rails: chip-id now %#x (A630v2 expects %#x)\n",
+	    polaris_gpu_rd(POLARIS_GPU_CHIPID), POLARIS_A630V2_CHIPID);
+	return true;
+}
