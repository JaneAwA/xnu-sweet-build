+/*
+ * GPUCC/GFXCC live in one shared 0x05090000..0x05098fff window; the GPU core
+ * registers below it start at 0x05000000. The board contract pins the two
+ * power domains at +0x106c (CX) and +0x100c (GX). CX is ours to switch on
+ * before any clock work. GX is *not*: KGSL asks the GMU for it, and flipping
+ * that switch by hand is what the contract forbids.
+ */
+#define POLARIS_GPU_REGS_PA     0x05000000UL
+#define POLARIS_GPU_REGS_SIZE   0x100000UL
+#define POLARIS_GPU_CHIPID      0x00000u
+#define POLARIS_GPU_CX_GDSCR    0x9106cu
+#define POLARIS_GPU_GX_GDSCR    0x9100cu
+#define POLARIS_GPU_GDSC_PWR_ON (1u << 31)
+#define POLARIS_GPU_GDSC_COLLAPSE 1u
+
+/* RBBM id for A630v2 as reported by the vendor kernel: 0x06030001. */
+#define POLARIS_A630V2_CHIPID   0x06030001u
+
+/* Lowest non-zero corner. RPMh aggregates by max, so this cannot lower a rail. */
+#define POLARIS_GPU_ARC_LEVEL   1u
+
+#define POLARIS_GPU_OWN_CX      (1u << 0)
+
+static vm_offset_t polaris_gpu_regs;
+
+static inline uint32_t
+polaris_gpu_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(polaris_gpu_regs + off);
+}
+
+static inline void
+polaris_gpu_wr(uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(polaris_gpu_regs + off) = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
