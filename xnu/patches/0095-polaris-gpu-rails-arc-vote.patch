diff --git a/bsd/dev/sweet_rpmh.c b/bsd/dev/sweet_rpmh.c
index 4da50d8..7a455e2 100644
--- a/bsd/dev/sweet_rpmh.c
+++ b/bsd/dev/sweet_rpmh.c
@@ -324,6 +324,202 @@ rh_send(uint32_t address, unsigned mv)
 	return 0;
 }
 
+/*
+ * ARC (level) votes.
+ *
+ * The L11C path above is a PMIC5 LDO: three commands (voltage, mode, enable)
+ * on RSC slave 4, with the resource type encoded as 4 in the address. An ARC
+ * corner is a different animal -- one command, one word, slave 3, type 3.
+ * rpmh-regulator calls that word the level, 0..15; RPMh aggregates every
+ * client by maximum, so a low vote can never pull a rail below what another
+ * owner already requested.
+ */
+#define RH_ARC          3u
+#define RH_ARC_MAX      16u
+
+static int
+rh_lookup_arc(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			printf("SWEET RPMH: malformed cmd-db slave header %u\n", i);
+			return EINVAL;
+		}
+		if (slave != RH_ARC) {
+			continue;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16);
+			if ((addr >> 16) != RH_ARC || (addr & 15u)) {
+				printf("SWEET RPMH: invalid ARC entry for %s\n", res);
+				return EINVAL;
+			}
+			*address = addr;
+			++matches;
+			printf("SWEET RPMH: %s arc addr=%#x slave=%u\n", res, addr, slave);
+		}
+	}
+	if (matches != 1) {
+		printf("SWEET RPMH: %s arc lookup matches=%u; refusing\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+/*
+ * Single-command TCS transaction. Same handshake as rh_send(), but WAIT and
+ * ENABLE select command 0 only. WAIT=0 would tell the RSC to wait for nothing
+ * and the slot would never retire.
+ */
+static int
+rh_send_one(uint32_t address, uint32_t data)
+{
+	int chosen = -1;
+
+	for (unsigned t = 0; t < RH_ACTIVE_N; ++t) {
+		uint32_t b = t * RH_TCS_STRIDE;
+		uint32_t enabled = rh_read(rh_tcs, b + RH_ENABLE);
+		printf("SWEET RPMH: ARC TCS%u idle=%#x control=%#x enable=%#x wait=%#x\n",
+		    t, rh_read(rh_tcs, b + RH_STATUS), rh_read(rh_tcs, b + RH_CONTROL),
+		    enabled, rh_read(rh_tcs, b + RH_WAIT));
+		if (enabled & ~((1u << rh_ncpt) - 1u)) {
+			return EIO;
+		}
+		if (chosen < 0 && rh_free(t)) {
+			chosen = (int)t;
+		}
+	}
+	if (chosen < 0) {
+		printf("SWEET RPMH: no empty idle ACTIVE TCS for the ARC vote\n");
+		return EBUSY;
+	}
+	unsigned t = (unsigned)chosen;
+	uint32_t b = t * RH_TCS_STRIDE, bit = 1u << t;
+	uint32_t irq_en = rh_read(rh_tcs, RH_IRQ_EN);
+	if (irq_en == 0xffffffffu || !rh_free(t)) {
+		return EBUSY;
+	}
+	if (!rh_sync(RH_IRQ_EN, irq_en & ~bit)) {
+		rh_poisoned = true;
+		return EIO;
+	}
+	if (!rh_free(t)) {
+		if (!rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+			rh_poisoned = true;
+		}
+		return EBUSY;
+	}
+	rh_poisoned = true;
+	uint32_t cmd = b;
+	if (!rh_sync(cmd + RH_MSGID, RH_WRITE_ACK) ||
+	    !rh_sync(cmd + RH_ADDR, address) ||
+	    !rh_sync(cmd + RH_DATA, data)) {
+		return EIO;
+	}
+	if (!rh_sync(b + RH_WAIT, 1) || !rh_sync(b + RH_ENABLE, 1) ||
+	    !rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
+	uint32_t irq = 0, idle = 0, status = 0;
+	bool done = false, progress = false;
+	for (unsigned us = 0; us < RH_TIMEOUT_US; ++us) {
+		irq = rh_read(rh_tcs, RH_IRQ_STATUS);
+		idle = rh_read(rh_tcs, b + RH_STATUS);
+		status = rh_read(rh_tcs, b + RH_CMD_STATUS);
+		bool complete = status != 0xffffffffu &&
+		    (status & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
+		progress |= idle == 0 || !complete;
+		if (idle && idle != 0xffffffffu && irq != 0xffffffffu &&
+		    ((irq & bit) || progress) && complete) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	printf("SWEET RPMH: ARC TCS%u done=%d irq=%#x idle=%#x cmd-status=%#x\n",
+	    t, done, irq, idle, status);
+	if (!done) {
+		printf("SWEET RPMH: ARC vote timeout; TCS quarantined, no retry\n");
+		return ETIMEDOUT;
+	}
+	if (!rh_sync(b + RH_CONTROL, RH_AMC_EN) || !rh_sync(b + RH_CONTROL, 0) ||
+	    !rh_sync(b + RH_ENABLE, 0) || !rh_sync(b + RH_WAIT, 0)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, RH_IRQ_CLEAR, bit);
+	if ((rh_read(rh_tcs, RH_IRQ_STATUS) & bit) ||
+	    !rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+		return EIO;
+	}
+	rh_poisoned = false;
+	return 0;
+}
+
+int
+sweet_rpmh_arc_level(const char *res, unsigned level)
+{
+	static const char *const known[] = {
+		"gfx.lvl", "cx.lvl", "mx.lvl", "ebi.lvl"
+	};
+	bool allowed = false;
+
+	if (!res || level >= RH_ARC_MAX) {
+		printf("SWEET RPMH: ARC level must be 0..%u\n", RH_ARC_MAX - 1u);
+		return EINVAL;
+	}
+	for (unsigned i = 0; i < sizeof(known) / sizeof(known[0]); ++i) {
+		if (!strcmp(res, known[i])) {
+			allowed = true;
+		}
+	}
+	if (!allowed) {
+		printf("SWEET RPMH: %s is not a known ARC resource\n", res);
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing ARC vote\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup_arc(res, &address);
+	}
+	if (!error) {
+		error = rh_send_one(address, level);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: ARC vote %s=%u failed errno=%d\n", res, level, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
 int
 sweet_rpmh_vreg_enable(const char *res, unsigned mv)
 {
