--- a/bsd/dev/polaris_gpu.c
+++ b/bsd/dev/polaris_gpu.c
@@ -32,12 +32,103 @@
 /* RBBM id for A630v2 as reported by the vendor kernel: 0x06030001. */
 #define POLARIS_A630V2_CHIPID   0x06030001u
 
+/*
+ * Clocks. Two controllers feed the GPU block on SDM845 and both have to be
+ * told "on" before any register inside the GPU answers:
+ *
+ *  - GCC (0x00100000) holds the bus and AHB branches; the offsets are the
+ *    mainline gcc-sdm845 ones (cfg_ahb 0x71004, memnoc 0x7100c, snoc_dvm
+ *    0x71018, ddrss_gpu_axi 0x44038) plus the two GPU taps of GPLL0 at
+ *    0x52004.
+ *  - GPUCC (inside the GPU window at +0x91000) holds the GMU's own branch
+ *    (0x1098) and the always-on CXO branch (0x109c); its root generator is
+ *    left exactly as the boot loader programmed it -- the loaders we have
+ *    seen do configure it, and writing a root we cannot read back is how a
+ *    bring-up loses the display it was going to draw on.
+ *
+ * A branch reports "halted" in bit 31 of its CBCR, so a cleared bit 31 after
+ * an enable is the only proof that the clock actually runs.
+ */
+#define POLARIS_GCC_PA          0x00100000UL
+#define POLARIS_GCC_SIZE        0x00080000UL
+#define POLARIS_GCC_GPU_CFG_AHB     0x71004u
+#define POLARIS_GCC_GPU_MEMNOC      0x7100cu
+#define POLARIS_GCC_GPU_SNOC_DVM    0x71018u
+#define POLARIS_GCC_DDRSS_GPU_AXI   0x44038u
+#define POLARIS_GCC_GPLL0_GPU_VOTE  0x52004u
+
+#define POLARIS_GPUCC_CX_GMU_CBCR   0x91098u
+#define POLARIS_GPUCC_CXO_CBCR      0x9109cu
+#define POLARIS_GPUCC_GMU_RCG_CMD   0x91120u
+/* The GMU's wrapper: the first registers that prove the CX half is alive. */
+#define POLARIS_GMU_PA          0x0506a000UL
+#define POLARIS_GMU_SIZE        0x00001000UL
+
+#define POLARIS_CBCR_ENABLE     (1u << 0)
+#define POLARIS_CBCR_HALTED     (1u << 31)
+#define POLARIS_CX_GMU_WAKE     (0xfu << 8)
+#define POLARIS_CX_GMU_SLEEP    (0xfu << 4)
+
 /* Lowest non-zero corner. RPMh aggregates by max, so this cannot lower a rail. */
 #define POLARIS_GPU_ARC_LEVEL   1u
 
 #define POLARIS_GPU_OWN_CX      (1u << 0)
+#define POLARIS_GPU_OWN_GCC     (1u << 1)
+#define POLARIS_GPU_OWN_GPUCC   (1u << 2)
 
 static vm_offset_t polaris_gpu_regs;
+static vm_offset_t polaris_gcc_regs;
+static vm_offset_t polaris_gmu_regs;
+
+static struct {
+	uint32_t off;
+	uint32_t saved;
+	bool     have;
+} polaris_gcc_saved[5];
+static struct {
+	uint32_t off;
+	uint32_t saved;
+} polaris_gpucc_saved[2];
+
+static inline uint32_t
+polaris_reg_rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static inline void
+polaris_reg_wr(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* Enable one branch and wait for its CBCR to stop saying "halted". */
+static bool
+polaris_branch_on(vm_offset_t base, uint32_t off, uint32_t extra_mask,
+    uint32_t extra_value, const char *what)
+{
+	uint32_t before = polaris_reg_rd(base, off);
+	uint32_t value = before | POLARIS_CBCR_ENABLE;
+	uint32_t after;
+
+	if (extra_mask != 0) {
+		value = (value & ~extra_mask) | extra_value;
+	}
+	polaris_reg_wr(base, off, value);
+	for (unsigned i = 0; i < 100; ++i) {
+		after = polaris_reg_rd(base, off);
+		if (!(after & POLARIS_CBCR_HALTED)) {
+			printf("POLARIS GPU: clocks: %s on, cBCR %#x -> %#x\n",
+			    what, before, after);
+			return true;
+		}
+		delay(1);
+	}
+	printf("POLARIS GPU: clocks: %s did not start, cBCR %#x -> %#x\n",
+	    what, before, polaris_reg_rd(base, off));
+	return false;
+}
 
 static inline uint32_t
 polaris_gpu_rd(uint32_t off)
@@ -173,6 +264,103 @@
 }
 
 /*
+ * Clocks backend, opt-in with polarisgpu_clocks=1 so a boot that only wants
+ * the rails (the one that reaches the lock screen) is unchanged. Everything
+ * written here is saved first and put back by unwind().
+ */
+static bool
+polaris_gpu_clocks_backend(struct polaris_gpu_context *ctx)
+{
+	static const struct {
+		uint32_t    off;
+		const char *name;
+	} gcc[] = {
+		{ POLARIS_GCC_GPU_CFG_AHB,    "gpu_cfg_ahb" },
+		{ POLARIS_GCC_GPU_MEMNOC,     "gpu_memnoc_gfx" },
+		{ POLARIS_GCC_GPU_SNOC_DVM,   "gpu_snoc_dvm_gfx" },
+		{ POLARIS_GCC_DDRSS_GPU_AXI,  "ddrss_gpu_axi" },
+		{ POLARIS_GCC_GPLL0_GPU_VOTE, "gpu_gpll0_vote" },
+	};
+	int probe_gmu = 0;
+
+	if (polaris_gcc_regs == 0) {
+		polaris_gcc_regs = ml_io_map(POLARIS_GCC_PA, POLARIS_GCC_SIZE);
+		if (polaris_gcc_regs == 0) {
+			printf("POLARIS GPU: clocks: GCC mapping failed\n");
+			return false;
+		}
+	}
+
+	for (unsigned i = 0; i < sizeof(gcc) / sizeof(gcc[0]); ++i) {
+		uint32_t value = polaris_reg_rd(polaris_gcc_regs, gcc[i].off);
+		polaris_gcc_saved[i].off = gcc[i].off;
+		polaris_gcc_saved[i].saved = value;
+		printf("POLARIS GPU: clocks: %s %#x = %#x%s\n", gcc[i].name,
+		    gcc[i].off, value, (value & POLARIS_CBCR_HALTED) ? " (halted)" : "");
+	}
+	ctx->owned |= POLARIS_GPU_OWN_GCC;
+
+	for (unsigned i = 0; i < sizeof(gcc) / sizeof(gcc[0]); ++i) {
+		uint32_t extra_mask = 0, extra_value = 0;
+		bool ok;
+		if (gcc[i].off == POLARIS_GCC_GPLL0_GPU_VOTE) {
+			/* Both taps of GPLL0: the main one and the divided one. */
+			extra_mask = 3u;
+			extra_value = 3u;
+		}
+		ok = polaris_branch_on(polaris_gcc_regs, gcc[i].off, extra_mask,
+		    extra_value, gcc[i].name);
+		if (!ok) {
+			return false;
+		}
+	}
+
+	/* GPUCC: CXO first, then the GMU's own branch with its wake/sleep fields. */
+	polaris_gpucc_saved[0].off = POLARIS_GPUCC_CXO_CBCR;
+	polaris_gpucc_saved[0].saved = polaris_gpu_rd(POLARIS_GPUCC_CXO_CBCR);
+	polaris_gpucc_saved[1].off = POLARIS_GPUCC_CX_GMU_CBCR;
+	polaris_gpucc_saved[1].saved = polaris_gpu_rd(POLARIS_GPUCC_CX_GMU_CBCR);
+	ctx->owned |= POLARIS_GPU_OWN_GPUCC;
+
+	printf("POLARIS GPU: clocks: gmu root cmd %#x = %#x (left as the loader set it)\n",
+	    POLARIS_GPUCC_GMU_RCG_CMD, polaris_gpu_rd(POLARIS_GPUCC_GMU_RCG_CMD));
+	if (!polaris_branch_on(polaris_gpu_regs, POLARIS_GPUCC_CXO_CBCR, 0, 0, "gpu_cc_cxo")) {
+		return false;
+	}
+	if (!polaris_branch_on(polaris_gpu_regs, POLARIS_GPUCC_CX_GMU_CBCR,
+	    POLARIS_CX_GMU_WAKE | POLARIS_CX_GMU_SLEEP,
+	    POLARIS_CX_GMU_WAKE | POLARIS_CX_GMU_SLEEP, "gpu_cc_cx_gmu")) {
+		return false;
+	}
+
+	printf("POLARIS GPU: clocks: gdscr cx=%#x gx=%#x chip-id=%#x\n",
+	    polaris_gpu_rd(POLARIS_GPU_CX_GDSCR), polaris_gpu_rd(POLARIS_GPU_GX_GDSCR),
+	    polaris_gpu_rd(POLARIS_GPU_CHIPID));
+
+	if (PE_parse_boot_argn("polarisgpu_gmu", &probe_gmu, sizeof(probe_gmu)) && probe_gmu == 1) {
+		if (polaris_gmu_regs == 0) {
+			polaris_gmu_regs = ml_io_map(POLARIS_GMU_PA, POLARIS_GMU_SIZE);
+		}
+		if (polaris_gmu_regs == 0) {
+			printf("POLARIS GPU: clocks: GMU mapping failed\n");
+			return false;
+		}
+		uint32_t a0 = polaris_reg_rd(polaris_gmu_regs, 0x00);
+		uint32_t a1 = polaris_reg_rd(polaris_gmu_regs, 0x04);
+		uint32_t a2 = polaris_reg_rd(polaris_gmu_regs, 0x08);
+		uint32_t a3 = polaris_reg_rd(polaris_gmu_regs, 0x0c);
+		delay(10);
+		printf("POLARIS GPU: gmu: %#x %#x %#x %#x then %#x %#x %#x %#x\n",
+		    a0, a1, a2, a3,
+		    polaris_reg_rd(polaris_gmu_regs, 0x00),
+		    polaris_reg_rd(polaris_gmu_regs, 0x04),
+		    polaris_reg_rd(polaris_gmu_regs, 0x08),
+		    polaris_reg_rd(polaris_gmu_regs, 0x0c));
+	}
+	return true;
+}
+
+/*
  * Only an acquired resource may be released. Resource-specific release
  * callbacks must be installed before ANY power or mapping code is enabled.
  */
@@ -210,6 +398,13 @@
 		ctx->completed++;
 		return true;
 	}
+	if (stage == POLARIS_GPU_CLOCKS) {
+		if (!polaris_gpu_clocks_backend(ctx)) {
+			return false;
+		}
+		ctx->completed++;
+		return true;
+	}
 	printf("POLARIS GPU: %s backend not implemented; no hardware access\n",
 	    polaris_gpu_stage_name[stage]);
 	return false;
@@ -225,6 +420,24 @@
 		return;
 	}
 	/* Release exactly what this boot switched on, newest first. */
+	if (ctx->owned & POLARIS_GPU_OWN_GPUCC) {
+		for (unsigned i = 0; i < sizeof(polaris_gpucc_saved) / sizeof(polaris_gpucc_saved[0]); ++i) {
+			polaris_reg_wr(polaris_gpu_regs, polaris_gpucc_saved[i].off,
+			    polaris_gpucc_saved[i].saved);
+		}
+		printf("POLARIS GPU: clocks: GPUCC branches restored\n");
+		ctx->owned &= ~POLARIS_GPU_OWN_GPUCC;
+	}
+	if (ctx->owned & POLARIS_GPU_OWN_GCC) {
+		for (unsigned i = 0; i < sizeof(polaris_gcc_saved) / sizeof(polaris_gcc_saved[0]); ++i) {
+			if (polaris_gcc_saved[i].off != 0) {
+				polaris_reg_wr(polaris_gcc_regs, polaris_gcc_saved[i].off,
+				    polaris_gcc_saved[i].saved);
+			}
+		}
+		printf("POLARIS GPU: clocks: GCC branches restored\n");
+		ctx->owned &= ~POLARIS_GPU_OWN_GCC;
+	}
 	if (ctx->owned & POLARIS_GPU_OWN_CX) {
 		polaris_gpu_wr(POLARIS_GPU_CX_GDSCR, ctx->cx_gdscr_saved);
 		printf("POLARIS GPU: rails: CX restored to %#x\n", ctx->cx_gdscr_saved);
@@ -261,8 +474,20 @@
 	if (!polaris_gpu_enter(&polaris_gpu, POLARIS_GPU_RAILS)) {
 		goto fail;
 	}
-	/* Clocks are the next backend; until it exists the rails are handed back. */
-	printf("POLARIS GPU: rails verified; no clock backend, handing back\n");
+	/*
+	 * The clock stage is a separate experiment on purpose: the rails-only
+	 * boot is the one that reaches the lock screen today, and a clock that
+	 * does not start must not cost that.
+	 */
+	int clocks = 0;
+	if (!PE_parse_boot_argn("polarisgpu_clocks", &clocks, sizeof(clocks)) || clocks != 1) {
+		printf("POLARIS GPU: rails verified; clocks off (polarisgpu_clocks=1 to try)\n");
+		goto fail;
+	}
+	if (!polaris_gpu_enter(&polaris_gpu, POLARIS_GPU_CLOCKS)) {
+		goto fail;
+	}
+	printf("POLARIS GPU: clocks verified; no GMU firmware backend, handing back\n");
 fail:
 	polaris_gpu_unwind(&polaris_gpu, true);
 	printf("POLARIS GPU: acceleration unavailable; CPU display unchanged\n");
