--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -285,6 +285,28 @@
 	sweet_log_append(c, size);
 	if (sweet_console_muted && !panic_active()) {
 		return;
+	}
+	/*
+	 * backboardd looks for the colour-space converter once per composited
+	 * frame, does not find it on this platform, and writes the failure to
+	 * /dev/console. It is harmless but it buries every other message, so the
+	 * panel does not get it. The ring above already has the bytes, and a
+	 * panic still draws everything.
+	 */
+	{
+		static const char noise[] = "IOServiceMatching failed";
+		const int n = (int)sizeof(noise) - 1;
+
+		for (int i = 0; i + n <= size; i++) {
+			int k = 0;
+
+			while (k < n && c[i + k] == noise[k]) {
+				k++;
+			}
+			if (k == n) {
+				return;
+			}
+		}
 	}
 #endif
 
